# Books, authors, genres, publishers for selected countries, 1960–1985
# Книги, авторы, жанры, издатели для выбранных стран, 1960–1985
SELECT DISTINCT
  ?book                                   # URI книги
  ?bookLabel                              # Название книги
  ?author                                 # URI автора
  ?authorLabel                            # Имя автора
  ?genreLabel                             # Жанр
  ?pubDate                                # Дата публикации
  ?publisherLabel                         # Издатель
WHERE {
  VALUES ?genre { wd:Q132311 wd:Q24925 wd:Q319226 }   # фэнтези, научная фантастика, приключенческая литература
  VALUES ?citizenship { wd:Q30 wd:Q145 wd:Q15180 wd:Q159 }    # США, Великобритания, СССР, Россия
  
  ?book wdt:P31 wd:Q7725634 ;             # экземпляр: литературное произведение
        wdt:P50 ?author ;                 # автор
        wdt:P136 ?genre ;                 # жанр
        wdt:P577 ?pubDate .               # дата публикации

  ?author wdt:P27 ?citizenship .          # гражданство автора

  FILTER(YEAR(?pubDate) >= 1960 && YEAR(?pubDate) <= 1985)

  OPTIONAL { ?book wdt:P123 ?publisher . }  # издатель

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,mul" }
}
