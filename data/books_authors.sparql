# Авторы книг жанров фэнтези (Q132311), научная фантастика (Q24925),
# приключенческая литература (Q319226), выпущенных в 1950–1985 годах.
# Колонки: URI автора, псевдоним, дата рождения, дата смерти, супруг/супруга, гражданство, жанр.

SELECT DISTINCT
  ?author                                  # URI автора (ключ для соединения)
  ?pseudonymLabel                          # Псевдоним
  ?birthDate                               # Дата рождения
  ?deathDate                               # Дата смерти
  ?spouseLabel                             # Супруг/супруга
  ?citizenshipLabel                        # Гражданство
  ?genreLabel                              # Жанр (фэнтези, научная фантастика, приключенческая литература)
WHERE {
  # Подзапрос: находим URI авторов и жанры их книг, выпущенных в 1950–1985
  {
    SELECT DISTINCT ?author ?genre WHERE {
      ?book wdt:P31 wd:Q7725634 ;             # Литературное произведение
            wdt:P136 ?genre ;
            wdt:P50 ?author ;               # Автор
            wdt:P577 ?pubDate .
      VALUES ?genre { wd:Q132311 wd:Q24925 wd:Q319226 }  # Фэнтези, научная фантастика, приключения
      FILTER(YEAR(?pubDate) >= 1950 && YEAR(?pubDate) <= 1985)
    }
  }

  # Свойства авторов
  OPTIONAL { ?author wdt:P742 ?pseudonym. }       # Псевдоним
  OPTIONAL { ?author wdt:P569 ?birthDate. }       # Дата рождения
  OPTIONAL { ?author wdt:P570 ?deathDate. }       # Дата смерти
  OPTIONAL { ?author wdt:P26 ?spouse. }           # Супруг/супруга
  OPTIONAL { ?author wdt:P27 ?citizenship. }      # Гражданство

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,mul". }
}
